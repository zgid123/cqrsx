{
  "name": "cqrsx",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "CQRS Library",
  "author": "Alpha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgid123/cqrsx.git"
  },
  "keywords": [
    "cqrs",
    "cqrsx"
  ],
  "license": "MIT",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "clear": "pnpm -r exec rimraf node_modules dist .turbo lib && pnpm rimraf node_modules .turbo",
    "test": "vitest run --coverage",
    "update-packages": "pnpm update -i -r --latest",
    "build": "turbo run build",
    "release": "pnpm build && changeset version && pnpm publish -r",
    "set-release": "changeset"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@alphacifer/biome": "^0.0.11",
    "@alphacifer/tsconfig": "^0.0.15",
    "@biomejs/biome": "2.4.13",
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.31.0",
    "@vitest/coverage-istanbul": "4.1.5",
    "changeset": "0.2.6",
    "lefthook": "2.1.6",
    "rimraf": "6.1.3",
    "tsdown": "0.21.10",
    "turbo": "2.9.14",
    "vitest": "4.1.5"
  }
}
